{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marinus Desktop",
  "version": "0.1.0",
  "identifier": "io.github.kws.marinus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "Marinus", "width": 1120, "height": 760, "minWidth": 760, "minHeight": 520}],
    "security": {"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; object-src 'none'; base-uri 'none'"}
  },
  "bundle": {
    "active": true,
    "resources": {"resources/backend/": "backend/", "resources/notices/": "notices/"},
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Wi-Fi observations for site surveys",
    "license": "MIT",
    "macOS": {"minimumSystemVersion": "13.0"},
    "windows": {"nsis": {"installMode": "currentUser"}},
    "linux": {"deb": {"depends": ["python3 (>= 3.10)", "python3-dbus", "network-manager"]}}
  }
}
